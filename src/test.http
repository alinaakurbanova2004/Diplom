### Проверка здоровья сервера
GET http://127.0.0.1:5000/api/health

### Получить список правил
GET http://127.0.0.1:5000/api/rules

### Анализ простого кода с одной процедурой
POST http://127.0.0.1:5000/api/analyze/code
Content-Type: application/json

{
    "code": "Процедура Привет()\n    Сообщить(\"Здравствуй, мир!\");\nКонецПроцедуры",
    "module_name": "hello.bsl",
    "apply_rules": true
}

### Анализ кода с ошибками (для проверки правил)
POST http://127.0.0.1:5000/api/analyze/code
Content-Type: application/json

{
    "code": "Функция Сумма(А, Б, В, Г, Д, Е, Ё, Ж)\n    Возврат А + Б;\nКонецФункции\n\nПерем x;\n\nПроцедура Пусто()\n    // пусто\nКонецПроцедуры",
    "module_name": "errors.bsl",
    "apply_rules": true
}