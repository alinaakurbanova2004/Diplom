Перем p;                        // одна буква
Перем _сумма;                   // подчеркивание в начале
Перем кол;                      // сокращение
Перем ПОЛУЧЕНИЕ_СКИДКИ;         // все заглавные

Процедура РассчитатьПродажи()
    Перем i;                    // одна буква
    Перем _временнаяПеременная; // подчеркивание в начале
    Перем бон;                  // сокращение
    Перем ОБЩАЯ_СУММА;          // все заглавные
    
    // Переменные внутри процедуры для демонстрации
    p = 0;
    _сумма = 1000;
    кол = 5;
    ПОЛУЧЕНИЕ_СКИДКИ = 10;
    i = 0;
    _временнаяПеременная = 0;
    бон = 0;
    ОБЩАЯ_СУММА = 0;
    
    Для i = 1 По кол Цикл
        ОБЩАЯ_СУММА = ОБЩАЯ_СУММА + _сумма;
        _временнаяПеременная = ОБЩАЯ_СУММА * ПОЛУЧЕНИЕ_СКИДКИ / 100;
    КонецЦикла;
КонецПроцедуры

Процедура ПосчитатьСумму()
    Перем р;                    // одна буква
    Перем _итог;                // подчеркивание в начале
    Перем текСумма;             // сокращение
    
    р = 100;
    _итог = 0;
    текСумма = р * 5;
КонецПроцедуры

Процедура Главная()
    РассчитатьПродажи();
    ПосчитатьСумму();
КонецПроцедуры

