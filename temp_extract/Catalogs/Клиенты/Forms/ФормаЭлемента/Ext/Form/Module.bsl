  &НаКлиенте
Процедура РассчитатьСкидку(Команда)
    
    // Расчет скидки в зависимости от суммы покупок
    Перем СуммаПокупок;
    
    СуммаПокупок = ПолучитьСуммуПокупокНаСервере();
    
    Если СуммаПокупок > 1000000 Тогда
        Объект.Скидка = 15;
    ИначеЕсли СуммаПокупок > 500000 Тогда
        Объект.Скидка = 10;
    ИначеЕсли СуммаПокупок > 100000 Тогда
        Объект.Скидка = 5;
    Иначе
        Объект.Скидка = 0;
    КонецЕсли;
    
    Сообщить("Установлена скидка: " + Объект.Скидка + "%");
    
КонецПроцедуры

&НаСервере
Функция ПолучитьСуммуПокупокНаСервере()
    
    // Здесь должен быть запрос к регистрам или документам продаж
    // Для примера возвращаем случайную сумму
    Возврат 750000;
    
КонецФункции
